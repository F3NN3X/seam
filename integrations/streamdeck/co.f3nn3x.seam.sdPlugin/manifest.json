{
	"UUID": "co.f3nn3x.seam",
	"Name": "Seam",
	"Version": "0.7.0.0",
	"Author": "F3NN3X",
	"Description": "Switch workspaces, line up screens, and pause the pointer remap or the zones from a Stream Deck key. Needs Seam running.",
	"URL": "https://github.com/F3NN3X/seam",
	"Category": "Seam",
	"CategoryIcon": "imgs/plugin/category",
	"Icon": "imgs/plugin/icon",
	"CodePath": "bin/plugin.js",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "24"
	},
	"Actions": [
		{
			"UUID": "co.f3nn3x.seam.workspace",
			"Name": "Switch workspace",
			"Tooltip": "Switch to a workspace on the current desk. The key lights while that workspace is in use, with an amber dot once a window of it was moved or minimized.",
			"Icon": "imgs/actions/workspace/icon",
			"PropertyInspectorPath": "ui/workspace.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/workspace/key-off",
					"Title": "Workspace",
					"TitleAlignment": "bottom"
				},
				{
					"Image": "imgs/actions/workspace/key-on",
					"Title": "Workspace",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"UUID": "co.f3nn3x.seam.snap-back",
			"Name": "Snap back",
			"Tooltip": "Put the windows of the workspace in use back where it puts them.",
			"Icon": "imgs/actions/snap-back/icon",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/snap-back/key",
					"Title": "Snap back",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"UUID": "co.f3nn3x.seam.lineup",
			"Name": "Line up screens",
			"Tooltip": "Open Line Up to match the screen edges to your desk.",
			"Icon": "imgs/actions/lineup/icon",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/lineup/key",
					"Title": "Line up",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"UUID": "co.f3nn3x.seam.remap",
			"Name": "Pause or resume remap",
			"Tooltip": "Pause or resume the pointer remap across screens. The key follows Seam.",
			"Icon": "imgs/actions/remap/icon",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/remap/key-off",
					"Title": "Remap paused",
					"TitleAlignment": "bottom"
				},
				{
					"Image": "imgs/actions/remap/key-on",
					"Title": "Remap on",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"UUID": "co.f3nn3x.seam.zones",
			"Name": "Zones on or off",
			"Tooltip": "Turn window zones on or off. The key follows Seam.",
			"Icon": "imgs/actions/zones/icon",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/zones/key-off",
					"Title": "Zones off",
					"TitleAlignment": "bottom"
				},
				{
					"Image": "imgs/actions/zones/key-on",
					"Title": "Zones on",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"UUID": "co.f3nn3x.seam.zone-next",
			"Name": "Next zone",
			"Tooltip": "Move the focused window to the next zone.",
			"Icon": "imgs/actions/zone-next/icon",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/zone-next/key",
					"Title": "Next zone",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"UUID": "co.f3nn3x.seam.zone-prev",
			"Name": "Previous zone",
			"Tooltip": "Move the focused window to the previous zone.",
			"Icon": "imgs/actions/zone-prev/icon",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/zone-prev/key",
					"Title": "Previous zone",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"UUID": "co.f3nn3x.seam.window-move",
			"Name": "Move window",
			"Tooltip": "Move the focused window left, right, up or down on the desk, zone to zone and across screens.",
			"Icon": "imgs/actions/window-move/icon",
			"PropertyInspectorPath": "ui/direction.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/window-move/key",
					"Title": "Move window",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"UUID": "co.f3nn3x.seam.window-focus",
			"Name": "Focus window",
			"Tooltip": "Focus the nearest window left, right, up or down on the desk.",
			"Icon": "imgs/actions/window-focus/icon",
			"PropertyInspectorPath": "ui/direction.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/window-focus/key",
					"Title": "Focus window",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"UUID": "co.f3nn3x.seam.pin-top",
			"Name": "Pin on top",
			"Tooltip": "Keep the focused window above the others, or press again to unpin it.",
			"Icon": "imgs/actions/pin-top/icon",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/pin-top/key",
					"Title": "Pin on top",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"UUID": "co.f3nn3x.seam.release",
			"Name": "Release pinned windows",
			"Tooltip": "Take back every pin and focus border Seam set.",
			"Icon": "imgs/actions/release/icon",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/release/key",
					"Title": "Release pins",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"UUID": "co.f3nn3x.seam.desk",
			"Name": "Desk",
			"Tooltip": "Shows the name of the active desk. Press it to open the Displays page.",
			"Icon": "imgs/actions/desk/icon",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/desk/key",
					"Title": "Desk",
					"TitleAlignment": "bottom"
				}
			]
		}
	]
}